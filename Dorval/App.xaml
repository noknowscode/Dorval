<Application x:Class="Dorval.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--  Load WinUI resources  -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme xmlns:utum="using:Uno.Toolkit.UI.Material" ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml">
          <utum:MaterialToolkitTheme.FontOverrideDictionary>
            <ResourceDictionary>
              <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Assets/Fonts/Figtree-Regular.ttf#Figtree</FontFamily>
              <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Assets/Fonts/Figtree-Regular.ttf#Figtree</FontFamily>
              <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Assets/Fonts/Figtree-Medium.ttf#Figtree Medium</FontFamily>
            </ResourceDictionary>
          </utum:MaterialToolkitTheme.FontOverrideDictionary>
        </utum:MaterialToolkitTheme>

        <!--  Dorval design system: palette first, then type, then controls that use both  -->
        <ResourceDictionary Source="ms-appx:///Themes/Colors.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
