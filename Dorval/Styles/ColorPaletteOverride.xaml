<!--
  Material roles mapped onto the Dorval palette, so any stock Material control
  that shows up is already on-brand. The design is single-theme (a civic app
  that reads like printed paper), so Dark carries the same values as Light.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#1E4B32</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#DDEBD3</Color>
      <Color x:Key="OnPrimaryContainerColor">#1E4B32</Color>
      <Color x:Key="SecondaryColor">#B8952F</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#F6E7C1</Color>
      <Color x:Key="OnSecondaryContainerColor">#3E2E05</Color>
      <Color x:Key="TertiaryColor">#1F4B66</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#D6E4EC</Color>
      <Color x:Key="OnTertiaryContainerColor">#1F4B66</Color>
      <Color x:Key="ErrorColor">#8C2F1E</Color>
      <Color x:Key="ErrorContainerColor">#F6DDD6</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#3F0E06</Color>
      <Color x:Key="BackgroundColor">#F5F3EC</Color>
      <Color x:Key="OnBackgroundColor">#1C2A21</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#1C2A21</Color>
      <Color x:Key="SurfaceVariantColor">#ECEAE1</Color>
      <Color x:Key="OnSurfaceVariantColor">#6B7568</Color>
      <Color x:Key="OutlineColor">#E4E1D6</Color>
      <Color x:Key="OutlineVariantColor">#EFEDE4</Color>
      <Color x:Key="OnSurfaceInverseColor">#F5F3EC</Color>
      <Color x:Key="SurfaceInverseColor">#1C2A21</Color>
      <Color x:Key="PrimaryInverseColor">#B9CDB0</Color>
      <Color x:Key="SurfaceTintColor">#1E4B32</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#1E4B32</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#DDEBD3</Color>
      <Color x:Key="OnPrimaryContainerColor">#1E4B32</Color>
      <Color x:Key="SecondaryColor">#B8952F</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#F6E7C1</Color>
      <Color x:Key="OnSecondaryContainerColor">#3E2E05</Color>
      <Color x:Key="TertiaryColor">#1F4B66</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#D6E4EC</Color>
      <Color x:Key="OnTertiaryContainerColor">#1F4B66</Color>
      <Color x:Key="ErrorColor">#8C2F1E</Color>
      <Color x:Key="ErrorContainerColor">#F6DDD6</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#3F0E06</Color>
      <Color x:Key="BackgroundColor">#F5F3EC</Color>
      <Color x:Key="OnBackgroundColor">#1C2A21</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#1C2A21</Color>
      <Color x:Key="SurfaceVariantColor">#ECEAE1</Color>
      <Color x:Key="OnSurfaceVariantColor">#6B7568</Color>
      <Color x:Key="OutlineColor">#E4E1D6</Color>
      <Color x:Key="OutlineVariantColor">#EFEDE4</Color>
      <Color x:Key="OnSurfaceInverseColor">#F5F3EC</Color>
      <Color x:Key="SurfaceInverseColor">#1C2A21</Color>
      <Color x:Key="PrimaryInverseColor">#B9CDB0</Color>
      <Color x:Key="SurfaceTintColor">#1E4B32</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
