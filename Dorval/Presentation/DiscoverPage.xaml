<Page x:Class="Dorval.Presentation.DiscoverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Dorval.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:Dorval.Models"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:vm="using:Dorval.Presentation"
      Background="{StaticResource PaperBrush}"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Padding="22,14,22,0" utu:SafeArea.Insets="Top">
      <controls:MockStatusBar Foreground="{StaticResource InkBrush}" />

      <TextBlock Margin="0,14,0,0"
                 Style="{StaticResource PageTitleStyle}"
                 Text="Discover" />
      <TextBlock Margin="0,4,0,0"
                 Style="{StaticResource CaptionFaintStyle}"
                 Text="{Binding Subtitle}" />

      <!--  Chips bleed past the right edge to signal there are more of them.  -->
      <ScrollViewer Margin="0,12,-22,0"
                    Padding="0,0,22,0"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
        <muxc:ItemsRepeater ItemsSource="{Binding Chips}">
          <muxc:ItemsRepeater.Layout>
            <muxc:StackLayout Orientation="Horizontal" Spacing="6" />
          </muxc:ItemsRepeater.Layout>
          <muxc:ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChip">
              <ToggleButton Content="{Binding Label}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Style="{StaticResource SoftChipStyle}" />
            </DataTemplate>
          </muxc:ItemsRepeater.ItemTemplate>
        </muxc:ItemsRepeater>
      </ScrollViewer>
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  Padding="0,18,0,20"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="14">

        <Grid Padding="22,0">
          <TextBlock VerticalAlignment="Bottom"
                     Style="{StaticResource SectionHeadingStyle}"
                     Text="This weekend" />
          <Button HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Command="{Binding SeeAllCommand}"
                  Content="See all"
                  Style="{StaticResource LinkButtonStyle}" />
        </Grid>

        <TextBlock Margin="22,-6,22,0"
                   Style="{StaticResource MetaFaintStyle}"
                   Text="Nothing matches — try clearing a filter."
                   Visibility="{Binding WeekendIsEmpty}" />

        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled">
          <muxc:ItemsRepeater Margin="22,0"
                              ItemsSource="{Binding WeekendEvents}"
                              uen:Navigation.Request="Event">
            <muxc:ItemsRepeater.Layout>
              <muxc:StackLayout Orientation="Horizontal" Spacing="10" />
            </muxc:ItemsRepeater.Layout>
            <muxc:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="models:DorvalEvent">
                <StackPanel Width="120" Spacing="8">
                  <controls:SlotImage Height="110"
                                      SlotCornerRadius="14"
                                      Source="{Binding ImageUrl}"
                                      Tint="{StaticResource TintLeafBrush}" />
                  <TextBlock Style="{StaticResource ListTitleTinyStyle}" Text="{Binding Title}" />
                  <TextBlock Margin="0,-4,0,0"
                             Style="{StaticResource CaptionFaintStyle}"
                             Text="{Binding Date}" />
                  <Border Padding="7,3"
                          HorizontalAlignment="Left"
                          Background="{StaticResource GreenSoftBrush}"
                          CornerRadius="5"
                          Visibility="{Binding IsFree}">
                    <TextBlock Foreground="{StaticResource GreenDeepBrush}"
                               Style="{StaticResource BadgeTextStyle}"
                               Text="FREE" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </muxc:ItemsRepeater.ItemTemplate>
          </muxc:ItemsRepeater>
        </ScrollViewer>

        <Grid Margin="0,6,0,0" Padding="22,0">
          <TextBlock VerticalAlignment="Bottom"
                     Style="{StaticResource SectionHeadingStyle}"
                     Text="Free in Dorval" />
          <Button HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Command="{Binding SeeAllCommand}"
                  Content="See all"
                  Style="{StaticResource LinkButtonStyle}" />
        </Grid>

        <Border Margin="16,0" Style="{StaticResource RowCardStyle}">
          <muxc:ItemsRepeater ItemsSource="{Binding FreeEvents}" uen:Navigation.Request="Event">
            <muxc:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="models:DorvalEvent">
                <Grid Padding="12"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="0,0,0,1"
                      ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:SlotImage Width="46"
                                      Height="46"
                                      SlotCornerRadius="10"
                                      Source="{Binding ImageUrl}"
                                      Tint="{StaticResource GreenSoftBrush}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource ListTitleSmallStyle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding WhenLine}" />
                    <TextBlock Style="{StaticResource CaptionFaintStyle}" Text="{Binding Place}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </muxc:ItemsRepeater.ItemTemplate>
          </muxc:ItemsRepeater>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
