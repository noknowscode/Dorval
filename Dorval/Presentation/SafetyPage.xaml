<Page x:Class="Dorval.Presentation.SafetyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Dorval.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:Dorval.Models"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{StaticResource CardBrush}"
      mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:ScreenHeader Eyebrow="SAFETY &amp; RESPECT" />

    <ScrollViewer Grid.Row="1"
                  Padding="22,20,22,30"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden"
                  utu:SafeArea.Insets="Bottom">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="22">
          <Border Width="64"
                  Height="64"
                  HorizontalAlignment="Left"
                  Background="{StaticResource GreenSoftBrush}"
                  CornerRadius="20">
            <controls:IconGlyph Data="M12 2l8 3v6c0 5-3.5 9.5-8 11-4.5-1.5-8-6-8-11V5zM9 12l2 2 4-4"
                                IconStroke="{StaticResource GreenDeepBrush}"
                                IconThickness="1.8"
                                Size="32" />
          </Border>

          <StackPanel>
            <TextBlock Style="{StaticResource HeroTitleStyle}" Text="A community you can trust" />
            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource BodyStyle}"
                       Foreground="{StaticResource InkMutedBrush}"
                       Text="A few ground rules keep Dorval's community space safe and respectful for everyone." />
          </StackPanel>

          <muxc:ItemsRepeater ItemsSource="{Binding Rules}">
            <muxc:ItemsRepeater.Layout>
              <muxc:StackLayout Spacing="14" />
            </muxc:ItemsRepeater.Layout>
            <muxc:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="models:GuidelineRule">
                <Grid ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="40"
                          Height="40"
                          Background="{StaticResource PaperBrush}"
                          BorderBrush="{StaticResource HairlineBrush}"
                          BorderThickness="1"
                          CornerRadius="12">
                    <controls:IconGlyph Data="{Binding IconData}"
                                        IconStroke="{StaticResource GreenDeepBrush}"
                                        IconThickness="1.8"
                                        Size="20" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource SansMedium}"
                             FontSize="15"
                             Foreground="{StaticResource InkBrush}"
                             LineHeight="20"
                             Text="{Binding Text}"
                             TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </muxc:ItemsRepeater.ItemTemplate>
          </muxc:ItemsRepeater>

          <Button HorizontalAlignment="Left"
                  Command="{Binding ShowGuidelinesCommand}"
                  Style="{StaticResource LinkButtonStyle}">
            <TextBlock FontFamily="{StaticResource SansRegular}"
                       FontSize="14"
                       Foreground="{StaticResource GreenMidBrush}"
                       Text="See full community guidelines in the app."
                       TextDecorations="Underline" />
          </Button>
        </StackPanel>

        <Button Grid.Row="1"
                Margin="0,24,0,0"
                VerticalAlignment="Bottom"
                Command="{Binding AgreeCommand}"
                Content="{Binding AgreeLabel}"
                Style="{StaticResource PrimaryActionButtonStyle}" />
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
