<Page x:Class="Dorval.Presentation.ReminderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Dorval.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{StaticResource CardBrush}"
      mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:ScreenHeader Eyebrow="REGISTRATION REMINDER" />

    <ScrollViewer Grid.Row="1"
                  Padding="22,8,22,30"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden"
                  utu:SafeArea.Insets="Bottom">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="18">
          <controls:SlotImage Height="190"
                              SlotCornerRadius="18"
                              Source="{Binding ImageUrl}"
                              Tint="{StaticResource SkyBrush}" />

          <TextBlock Style="{StaticResource HeroTitleStyle}" Text="Swimming registration opens Tuesday!" />

          <TextBlock Style="{StaticResource BodyLargeStyle}">
            <Run Text="For Dorval residents" />
            <LineBreak />
            <Run Text="Opens Tuesday, Sept 8 at 12:00 PM" />
          </TextBlock>

          <Border Padding="14"
                  Background="{StaticResource PaperBrush}"
                  CornerRadius="14">
            <StackPanel Spacing="8">
              <Grid>
                <TextBlock Style="{StaticResource MetaStyle}" Text="Ages" />
                <TextBlock HorizontalAlignment="Right"
                           FontFamily="{StaticResource SansBold}"
                           FontSize="13"
                           Foreground="{StaticResource InkBrush}"
                           Text="3 – 17" />
              </Grid>
              <Grid>
                <TextBlock Style="{StaticResource MetaStyle}" Text="Sessions" />
                <TextBlock HorizontalAlignment="Right"
                           FontFamily="{StaticResource SansBold}"
                           FontSize="13"
                           Foreground="{StaticResource InkBrush}"
                           Text="Sept 20 – Dec 13" />
              </Grid>
              <Grid>
                <TextBlock Style="{StaticResource MetaStyle}" Text="Where" />
                <TextBlock HorizontalAlignment="Right"
                           FontFamily="{StaticResource SansBold}"
                           FontSize="13"
                           Foreground="{StaticResource InkBrush}"
                           Text="Surrey Aquatic Centre" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,24,0,0"
                    VerticalAlignment="Bottom"
                    Spacing="12">
          <Button Background="{Binding ReminderBackground}"
                  Command="{Binding ToggleReminderCommand}"
                  Content="{Binding ReminderLabel}"
                  Foreground="{Binding ReminderForeground}"
                  Style="{StaticResource PrimaryActionButtonStyle}" />
          <TextBlock HorizontalAlignment="Center"
                     Style="{StaticResource MetaFaintStyle}"
                     Text="{Binding ReminderNote}"
                     TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
