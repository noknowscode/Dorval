<Page x:Class="Dorval.Presentation.TodayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Dorval.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{StaticResource PaperBrush}"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--
      The green dome. Its negative bottom margin lets the first cards ride up onto
      the curve, which is what makes the weekend headline feel like part of the sky.
    -->
    <controls:DomeHeader Margin="0,0,0,-66">
      <controls:DomeHeader.HeaderContent>
        <Grid>
          <StackPanel VerticalAlignment="Bottom">
            <TextBlock FontFamily="{StaticResource SansRegular}"
                       FontSize="15"
                       Foreground="{StaticResource OnGreenBrush}"
                       Opacity="0.9"
                       Text="Good afternoon," />
            <TextBlock Margin="0,2,0,0"
                       Style="{StaticResource GreetingStyle}"
                       Text="Dorval" />
          </StackPanel>

          <Button HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  AutomationProperties.Name="Notifications"
                  Command="{Binding RingBellCommand}"
                  Style="{StaticResource CircleIconOnGreenButtonStyle}">
            <controls:IconGlyph Data="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0"
                                IconStroke="{StaticResource OnGreenBrush}"
                                Size="20" />
          </Button>
        </Grid>
      </controls:DomeHeader.HeaderContent>
    </controls:DomeHeader>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel Padding="16,0,16,20" Spacing="14">

        <TextBlock Margin="6,0,0,0"
                   Style="{StaticResource EyebrowOnGreenStyle}"
                   Text="THIS WEEKEND" />

        <!--  The weekend headline: the one card that gets a photo and a shadow.  -->
        <Button Margin="0,-4,0,0"
                CornerRadius="18"
                Style="{StaticResource CardButtonStyle}"
                Translation="0,0,16"
                uen:Navigation.Data="{Binding Hero}"
                uen:Navigation.Request="Event">
          <Button.Shadow>
            <ThemeShadow />
          </Button.Shadow>
          <StackPanel>
            <controls:SlotImage Height="150"
                                SlotCornerRadius="17,17,0,0"
                                Source="{Binding Hero.ImageUrl}"
                                Tint="{StaticResource TintLeafBrush}" />
            <Grid Padding="16,14">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource CardTitleStyle}" Text="{Binding Hero.Title}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource MetaStyle}"
                           Text="{Binding Hero.WhenLine}" />
                <TextBlock Style="{StaticResource MetaFaintStyle}" Text="{Binding Hero.Place}" />
              </StackPanel>
              <Border Padding="8,4"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Background="{StaticResource GreenSoftBrush}"
                      CornerRadius="6"
                      Visibility="{Binding Hero.IsFree}">
                <TextBlock Foreground="{StaticResource GreenDeepBrush}"
                           Style="{StaticResource BadgeTextStyle}"
                           Text="FREE" />
              </Border>
            </Grid>
          </StackPanel>
        </Button>

        <TextBlock Style="{StaticResource EyebrowStyle}" Text="{Binding TodayLabel}" />

        <Button Margin="0,-6,0,0"
                Style="{StaticResource CardButtonStyle}"
                uen:Navigation.Data="{Binding Happening}"
                uen:Navigation.Request="Event">
          <Grid Padding="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:SlotImage Width="52"
                                Height="52"
                                SlotCornerRadius="10"
                                Source="{Binding Happening.ImageUrl}"
                                Tint="{StaticResource TintWheatBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource ListTitleStyle}" Text="{Binding Happening.Title}" />
              <TextBlock Style="{StaticResource MetaStyle}" Text="{Binding Happening.Time}" />
              <TextBlock Style="{StaticResource MetaFaintStyle}" Text="{Binding Happening.Place}" />
            </StackPanel>
            <controls:IconGlyph Grid.Column="2"
                                Data="M9 6l6 6-6 6"
                                IconStroke="{StaticResource InkFaintBrush}"
                                Size="18" />
          </Grid>
        </Button>

        <TextBlock Style="{StaticResource EyebrowStyle}" Text="COMING UP" />

        <Button Margin="0,-6,0,0"
                Style="{StaticResource CardButtonStyle}"
                uen:Navigation.Data="{Binding Upcoming}"
                uen:Navigation.Request="Event">
          <Grid Padding="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:SlotImage Width="52"
                                Height="52"
                                SlotCornerRadius="10"
                                Source="{Binding Upcoming.ImageUrl}"
                                Tint="{StaticResource TintFernBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource ListTitleStyle}" Text="{Binding Upcoming.Title}" />
              <TextBlock Style="{StaticResource MetaStyle}" Text="{Binding Upcoming.WhenLine}" />
              <TextBlock Style="{StaticResource MetaFaintStyle}" Text="Free · Registration required" />
            </StackPanel>
            <controls:IconGlyph Grid.Column="2"
                                Data="M9 6l6 6-6 6"
                                IconStroke="{StaticResource InkFaintBrush}"
                                Size="18" />
          </Grid>
        </Button>

        <!--  Only shown to a household that told us it has kids.  -->
        <Button Background="{StaticResource GreenSoftBrush}"
                BorderThickness="0"
                Command="{Binding ShowFamilyPicksCommand}"
                Style="{StaticResource CardButtonStyle}"
                Visibility="{Binding ShowFamilyCard}">
          <Grid Padding="16,14">
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
              <TextBlock Foreground="{StaticResource GreenDeepBrush}"
                         Style="{StaticResource ListTitleSmallStyle}"
                         Text="For your family" />
              <TextBlock Foreground="{StaticResource GreenMidBrush}"
                         Style="{StaticResource MetaStyle}"
                         Text="{Binding FamilyLine}" />
            </StackPanel>
            <controls:IconGlyph HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Data="M5 12h14M13 6l6 6-6 6"
                                IconStroke="{StaticResource GreenDeepBrush}"
                                Size="22" />
          </Grid>
        </Button>

        <Button Background="{StaticResource AmberBrush}"
                BorderThickness="0"
                Style="{StaticResource CardButtonStyle}"
                uen:Navigation.Request="Reminder">
          <Grid Padding="16,14">
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
              <TextBlock FontFamily="{StaticResource SansSemiBold}"
                         FontSize="12"
                         Foreground="{StaticResource AmberInkBrush}"
                         LineHeight="16"
                         Text="Registration opening soon" />
              <TextBlock Margin="0,2,0,0"
                         Foreground="{StaticResource AmberDeepBrush}"
                         Style="{StaticResource ListTitleStyle}"
                         Text="Fall swimming registration" />
              <TextBlock Foreground="{StaticResource AmberInkBrush}"
                         Style="{StaticResource MetaStyle}"
                         Text="Opens Tuesday at 12:00 PM" />
            </StackPanel>
            <controls:IconGlyph HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Data="M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM3 10h18M8 3v4M16 3v4"
                                IconStroke="{StaticResource AmberInkBrush}"
                                Size="22" />
          </Grid>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
