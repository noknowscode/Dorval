<Page x:Class="Dorval.Presentation.CommunityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Dorval.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:Dorval.Models"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:vm="using:Dorval.Presentation"
      Background="{StaticResource PaperBrush}"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

  <Page.Resources>
    <vm:CategoryBrushConverter x:Key="CategoryBrush" />
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:DomeHeader>
      <controls:DomeHeader.HeaderContent>
        <Grid>
          <TextBlock VerticalAlignment="Center"
                     Style="{StaticResource PageTitleOnGreenStyle}"
                     Text="Community" />
          <Button HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Safety and respect"
                  Style="{StaticResource CircleIconOnGreenButtonStyle}"
                  uen:Navigation.Request="Safety">
            <controls:IconGlyph Data="M12 2l8 3v6c0 5-3.5 9.5-8 11-4.5-1.5-8-6-8-11V5zM9 12l2 2 4-4"
                                IconStroke="{StaticResource OnGreenBrush}"
                                Size="20" />
          </Button>
        </Grid>
      </controls:DomeHeader.HeaderContent>
    </controls:DomeHeader>

    <ScrollViewer Grid.Row="1"
                  Padding="16,16,16,20"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="14">

        <!--  Four ways in. Picking one also filters the feed below it.  -->
        <Border Padding="14" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="How can we help?" />
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding HelpTiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:ColumnsPanel ColumnSpacing="10"
                                         Columns="2"
                                         RowSpacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HelpTileItem">
                  <Button Padding="10,16,10,12"
                          Background="{Binding Background}"
                          BorderBrush="{Binding BorderBrush}"
                          Command="{Binding Select}"
                          CommandParameter="{Binding Tile}"
                          CornerRadius="14"
                          Style="{StaticResource CardButtonStyle}">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                      <controls:IconGlyph Data="{Binding IconData}"
                                          IconStroke="{StaticResource GreenDeepBrush}"
                                          IconThickness="1.8"
                                          Size="26" />
                      <TextBlock HorizontalAlignment="Center"
                                 FontFamily="{StaticResource SansSemiBold}"
                                 FontSize="12"
                                 Foreground="{StaticResource InkBrush}"
                                 LineHeight="16"
                                 Text="{Binding Label}"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Grid Padding="4,0">
          <TextBlock VerticalAlignment="Bottom"
                     Style="{StaticResource SectionHeadingStyle}"
                     Text="{Binding NearbyTitle}" />
          <Button HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Command="{Binding ClearCategoryCommand}"
                  Content="{Binding NearbyLink}"
                  Style="{StaticResource LinkButtonStyle}" />
        </Grid>

        <Border Margin="0,-6,0,0" Style="{StaticResource CardStyle}">
          <Grid>
            <muxc:ItemsRepeater ItemsSource="{Binding Nearby}" uen:Navigation.Request="Post">
              <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="models:CommunityPost">
                  <Grid Padding="14"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:SlotImage Width="48"
                                        Height="48"
                                        VerticalAlignment="Top"
                                        SlotCornerRadius="10"
                                        Source="{Binding ImageUrl}"
                                        Tint="{StaticResource TintMistBrush}" />

                    <StackPanel Grid.Column="1" Spacing="4">
                      <Border Padding="7,3"
                              HorizontalAlignment="Left"
                              Background="{Binding Category, Converter={StaticResource CategoryBrush}}"
                              CornerRadius="5">
                        <TextBlock Foreground="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=Foreground}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Text="{Binding CategoryLabel}" />
                      </Border>

                      <TextBlock Style="{StaticResource ListTitleSmallStyle}" Text="{Binding Title}" />

                      <Grid>
                        <TextBlock Style="{StaticResource CaptionFaintStyle}" Text="{Binding Meta}" />
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                          <controls:IconGlyph Data="M21 12a8 8 0 0 1-8 8H5l-2 2V12a8 8 0 0 1 16 0z"
                                              IconStroke="{StaticResource InkFaintBrush}"
                                              Size="13" />
                          <TextBlock Style="{StaticResource CaptionFaintStyle}" Text="{Binding ReplyCount}" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>

            <StackPanel Padding="20,28"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Visibility="{Binding NearbyIsEmpty}">
              <TextBlock HorizontalAlignment="Center"
                         Style="{StaticResource BodySmallStyle}"
                         Foreground="{StaticResource InkMutedBrush}"
                         Text="{Binding EmptyLine}"
                         TextAlignment="Center" />
              <Button Height="40"
                      Padding="16,0"
                      HorizontalAlignment="Center"
                      Background="{StaticResource GreenDeepBrush}"
                      Command="{Binding ComposeCommand}"
                      Content="Start one"
                      CornerRadius="20"
                      Foreground="{StaticResource OnGreenBrush}"
                      Style="{StaticResource FlatButtonStyle}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
