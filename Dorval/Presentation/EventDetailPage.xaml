<Page x:Class="Dorval.Presentation.EventDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Dorval.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:sys="using:System"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{StaticResource CardBrush}"
      mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:ScreenHeader Eyebrow="EVENT">
      <controls:ScreenHeader.TrailingContent>
        <Button AutomationProperties.Name="Share"
                Command="{Binding ShareCommand}"
                Style="{StaticResource CircleIconButtonStyle}">
          <controls:IconGlyph Data="M12 3v13M7 8l5-5 5 5M5 14v6h14v-6"
                              IconStroke="{StaticResource InkBrush}"
                              Size="18" />
        </Button>
      </controls:ScreenHeader.TrailingContent>
    </controls:ScreenHeader>

    <ScrollViewer Grid.Row="1"
                  Padding="22,8,22,20"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="16">
        <controls:SlotImage Height="170"
                            SlotCornerRadius="18"
                            Source="{Binding Event.ImageUrl}"
                            Tint="{StaticResource TintLeafBrush}" />

        <StackPanel>
          <TextBlock Style="{StaticResource DetailTitleStyle}" Text="{Binding Event.Title}" />
          <TextBlock Margin="0,8,0,0"
                     Style="{StaticResource BodySmallStyle}"
                     Foreground="{StaticResource InkMutedBrush}"
                     Text="{Binding Event.WhenLine}" />
          <TextBlock Style="{StaticResource BodySmallStyle}"
                     Foreground="{StaticResource InkFaintBrush}"
                     Text="{Binding Event.Place}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Event.Tags}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <Border Height="30"
                      Padding="11,0"
                      Background="{StaticResource GreenPaleBrush}"
                      BorderBrush="{StaticResource GreenLineBrush}"
                      BorderThickness="1"
                      CornerRadius="15">
                <TextBlock Style="{StaticResource TagTextStyle}" Text="{Binding}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel>
          <TextBlock Style="{StaticResource EyebrowStyle}" Text="GOOD TO KNOW" />
          <muxc:ItemsRepeater Margin="0,8,0,0" ItemsSource="{Binding Event.GoodToKnow}">
            <muxc:ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource BodySmallStyle}" Text="•" />
                  <TextBlock Grid.Column="1"
                             Style="{StaticResource BodySmallStyle}"
                             LineHeight="24"
                             Text="{Binding}" />
                </Grid>
              </DataTemplate>
            </muxc:ItemsRepeater.ItemTemplate>
          </muxc:ItemsRepeater>
        </StackPanel>

        <StackPanel>
          <TextBlock Style="{StaticResource EyebrowStyle}" Text="LOCATION" />

          <!--  Tapping the map hands off to the Places tab, where it can be explored.  -->
          <Button Margin="0,8,0,0"
                  CornerRadius="14"
                  Style="{StaticResource CardButtonStyle}"
                  uen:Navigation.Request="-/Places">
            <Grid Height="96">
              <Viewbox Stretch="Fill">
                <Canvas Width="330" Height="96">
                  <Rectangle Width="330"
                             Height="96"
                             Fill="{StaticResource MapLandBrush}" />
                  <Path Data="M0 60 C60 50 120 80 200 70 S300 72 330 60 V96 H0Z" Fill="{StaticResource MapWaterBrush}" />
                  <Path Data="M0 25 H330 M0 55 H330 M70 0 V60 M150 0 V70 M240 0 V70"
                        Stroke="{StaticResource OnGreenBrush}"
                        StrokeThickness="5" />
                  <Rectangle Canvas.Left="180"
                             Canvas.Top="30"
                             Width="45"
                             Height="20"
                             Fill="{StaticResource MapParkBrush}"
                             RadiusX="3"
                             RadiusY="3" />
                </Canvas>
              </Viewbox>

              <Viewbox Width="30"
                       Height="36"
                       Margin="0,0,0,29"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <Canvas Width="24" Height="30">
                  <Path Data="M12 29s10-9.5 10-17A10 10 0 0 0 2 12c0 7.5 10 17 10 17z"
                        Fill="{StaticResource GreenDeepBrush}"
                        Stroke="{StaticResource OnGreenBrush}"
                        StrokeThickness="1.5" />
                  <Ellipse Canvas.Left="8"
                           Canvas.Top="8"
                           Width="8"
                           Height="8"
                           Fill="{StaticResource OnGreenBrush}" />
                </Canvas>
              </Viewbox>
            </Grid>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!--  Save, calendar, share: the calendar gets the width because it is the commitment.  -->
    <Grid Grid.Row="2"
          Padding="16,14,16,26"
          Background="{StaticResource CardBrush}"
          BorderBrush="{StaticResource DividerBrush}"
          BorderThickness="0,1,0,0"
          ColumnSpacing="8"
          utu:SafeArea.Insets="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="1.5*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Button Background="{Binding SaveBackground}"
              Command="{Binding ToggleSaveCommand}"
              Style="{StaticResource BarActionButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:IconGlyph Data="M12 21s-8-5.5-8-11.5A4.5 4.5 0 0 1 12 6a4.5 4.5 0 0 1 8 3.5C20 15.5 12 21 12 21z"
                              IconFill="{Binding HeartFill}"
                              IconStroke="{StaticResource GreenDeepBrush}"
                              Size="16" />
          <TextBlock VerticalAlignment="Center"
                     FontFamily="{StaticResource SansSemiBold}"
                     FontSize="13"
                     Foreground="{StaticResource GreenDeepBrush}"
                     Text="{Binding SaveLabel}" />
        </StackPanel>
      </Button>

      <Button Grid.Column="1"
              Command="{Binding AddToCalendarCommand}"
              Style="{StaticResource BarActionAccentButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:IconGlyph Data="M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM3 10h18M8 3v4M16 3v4"
                              IconStroke="{StaticResource OnGreenBrush}"
                              Size="16" />
          <TextBlock VerticalAlignment="Center"
                     FontFamily="{StaticResource SansSemiBold}"
                     FontSize="13"
                     Foreground="{StaticResource OnGreenBrush}"
                     Text="{Binding CalendarLabel}" />
        </StackPanel>
      </Button>

      <Button Grid.Column="2"
              Command="{Binding ShareCommand}"
              Style="{StaticResource BarActionButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:IconGlyph Data="M12 3v13M7 8l5-5 5 5M5 14v6h14v-6"
                              IconStroke="{StaticResource GreenDeepBrush}"
                              Size="16" />
          <TextBlock VerticalAlignment="Center"
                     FontFamily="{StaticResource SansSemiBold}"
                     FontSize="13"
                     Foreground="{StaticResource GreenDeepBrush}"
                     Text="Share" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Page>
