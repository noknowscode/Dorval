<Page x:Class="Dorval.Presentation.PlacesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Dorval.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:sys="using:System"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:vm="using:Dorval.Presentation"
      Background="{StaticResource PaperBrush}"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Padding="22,14,22,16"
                Background="{StaticResource GreenDeepBrush}"
                utu:SafeArea.Insets="Top">
      <controls:MockStatusBar Foreground="{StaticResource OnGreenBrush}" />

      <Grid Margin="0,14,0,0">
        <TextBlock VerticalAlignment="Center"
                   Style="{StaticResource PageTitleOnGreenStyle}"
                   Text="Places" />
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="Centre on my location"
                Command="{Binding LocateCommand}"
                Style="{StaticResource CircleIconInverseButtonStyle}">
          <controls:IconGlyph Data="M12 22s7-7 7-12a7 7 0 0 0-14 0c0 5 7 12 7 12zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"
                              IconStroke="{StaticResource GreenDeepBrush}"
                              Size="20" />
        </Button>
      </Grid>

      <ScrollViewer Margin="0,14,-22,0"
                    Padding="0,0,22,0"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
        <muxc:ItemsRepeater ItemsSource="{Binding Categories}">
          <muxc:ItemsRepeater.Layout>
            <muxc:StackLayout Orientation="Horizontal" Spacing="6" />
          </muxc:ItemsRepeater.Layout>
          <muxc:ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChip">
              <ToggleButton Content="{Binding Label}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Style="{StaticResource OnGreenChipStyle}" />
            </DataTemplate>
          </muxc:ItemsRepeater.ItemTemplate>
        </muxc:ItemsRepeater>
      </ScrollViewer>
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  Padding="16,14,16,20"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="14">
        <controls:CityMap Pins="{Binding Pins}" />

        <muxc:ItemsRepeater ItemsSource="{Binding Places}">
          <muxc:ItemsRepeater.Layout>
            <muxc:StackLayout Spacing="14" />
          </muxc:ItemsRepeater.Layout>
          <muxc:ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:PlaceListItem">
              <Button BorderBrush="{Binding BorderBrush}"
                      Command="{Binding Select}"
                      CommandParameter="{Binding Place.Id}"
                      CornerRadius="18"
                      Style="{StaticResource CardButtonStyle}">
                <Grid>
                  <!--  Selected: the full card, with tags and opening hours  -->
                  <StackPanel Visibility="{Binding IsExpanded}">
                    <controls:SlotImage Height="120"
                                        SlotCornerRadius="17,17,0,0"
                                        Source="{Binding ImageUrl}"
                                        Tint="{StaticResource TintLeafBrush}" />
                    <StackPanel Padding="16,14" Spacing="10">
                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1"
                                   Margin="0,6,0,0"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="{Binding Away}"
                                   TextWrapping="NoWrap" />
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sys:String">
                            <Border Height="26"
                                    Padding="9,0"
                                    Background="{StaticResource GreenSoftBrush}"
                                    CornerRadius="13">
                              <TextBlock Style="{StaticResource TagTextStyle}" Text="{Binding}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Grid Padding="0,10,0,0"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource MetaStyle}"
                                   Text="{Binding OpenLine}" />
                        <Border Padding="9,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{StaticResource GreenDeepBrush}"
                                CornerRadius="6">
                          <TextBlock Foreground="{StaticResource OnGreenBrush}"
                                     Style="{StaticResource BadgeTextStyle}"
                                     Text="Open" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </StackPanel>

                  <!--  Everything else: a compact row  -->
                  <Grid Padding="12"
                        ColumnSpacing="12"
                        Visibility="{Binding IsCompact}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:SlotImage Width="64"
                                        Height="56"
                                        SlotCornerRadius="10"
                                        Source="{Binding ImageUrl}"
                                        Tint="{StaticResource TintStoneBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource ListTitleStyle}" Text="{Binding Name}" />
                      <TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding Away}" />
                      <TextBlock Style="{StaticResource CaptionFaintStyle}" Text="{Binding OpenLine}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Padding="9,4"
                            VerticalAlignment="Center"
                            Background="{StaticResource GreenDeepBrush}"
                            CornerRadius="6">
                      <TextBlock Foreground="{StaticResource OnGreenBrush}"
                                 Style="{StaticResource BadgeTextStyle}"
                                 Text="Open" />
                    </Border>
                  </Grid>
                </Grid>
              </Button>
            </DataTemplate>
          </muxc:ItemsRepeater.ItemTemplate>
        </muxc:ItemsRepeater>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
