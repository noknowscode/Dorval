<Page x:Class="Dorval.Presentation.OnboardingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Dorval.Presentation.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:vm="using:Dorval.Presentation"
      Background="{StaticResource CardBrush}"
      mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Padding="22,14,22,0" utu:SafeArea.Insets="Top">
      <controls:MockStatusBar Foreground="{StaticResource InkBrush}" />

      <Grid Height="40" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="6">
          <Border Width="24"
                  Height="4"
                  Background="{StaticResource GreenDeepBrush}"
                  CornerRadius="2" />
          <Border Width="24"
                  Height="4"
                  Background="{StaticResource HairlineBrush}"
                  CornerRadius="2" />
        </StackPanel>

        <Button Padding="8,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding SkipCommand}"
                Content="Skip"
                CornerRadius="8"
                FontFamily="{StaticResource SansSemiBold}"
                FontSize="14"
                Foreground="{StaticResource InkFaintBrush}"
                Style="{StaticResource FlatButtonStyle}" />
      </Grid>
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  Padding="22,10,22,30"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden"
                  utu:SafeArea.Insets="Bottom">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="20">
          <controls:SlotImage Height="210"
                              SlotCornerRadius="18"
                              Source="{Binding ImageUrl}"
                              Tint="{StaticResource SkyBrush}" />

          <TextBlock HorizontalAlignment="Center"
                     Style="{StaticResource HeroTitleStyle}"
                     Text="Who are you looking for things to do for?"
                     TextAlignment="Center" />

          <!--  Two answers, one of them always chosen.  -->
          <Border Padding="4"
                  Background="{StaticResource PaperBrush}"
                  CornerRadius="14">
            <ItemsControl ItemsSource="{Binding Audiences}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:ColumnsPanel ColumnSpacing="4" Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Content="{Binding Label}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Style="{StaticResource SegmentChipStyle}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <StackPanel Spacing="10" Visibility="{Binding IsFamily}">
            <TextBlock Style="{StaticResource SectionHeadingSmallStyle}" Text="Kids in your household" />
            <ItemsControl ItemsSource="{Binding Ages}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Content="{Binding Label}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Style="{StaticResource AgeChipStyle}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource MetaFaintStyle}" Text="We'll highlight age-appropriate activities on your Today page." />
          </StackPanel>
        </StackPanel>

        <Button Grid.Row="1"
                Margin="0,24,0,0"
                VerticalAlignment="Bottom"
                Content="Continue"
                Style="{StaticResource PrimaryActionButtonStyle}"
                uen:Navigation.Request="Safety" />
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
