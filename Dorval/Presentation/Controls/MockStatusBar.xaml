<UserControl x:Class="Dorval.Presentation.Controls.MockStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d">

  <!--
    The device status row, drawn by the app on platforms that have no real one
    (desktop, WebAssembly). On Android and iOS this collapses and SafeArea hands
    the space to the OS instead.
  -->
  <Grid Height="20" VerticalAlignment="Center">
    <TextBlock VerticalAlignment="Center"
               FontFamily="{StaticResource SansSemiBold}"
               FontSize="14"
               Foreground="{Binding Foreground, ElementName=Root}"
               Text="9:41" />

    <Viewbox Width="52"
             Height="12"
             HorizontalAlignment="Right"
             VerticalAlignment="Center">
      <Canvas Width="52" Height="12">
        <!--  Cellular  -->
        <Rectangle Canvas.Left="0"
                   Canvas.Top="7"
                   Width="3"
                   Height="5"
                   Fill="{Binding Foreground, ElementName=Root}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle Canvas.Left="4.5"
                   Canvas.Top="5"
                   Width="3"
                   Height="7"
                   Fill="{Binding Foreground, ElementName=Root}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle Canvas.Left="9"
                   Canvas.Top="3"
                   Width="3"
                   Height="9"
                   Fill="{Binding Foreground, ElementName=Root}"
                   RadiusX="1"
                   RadiusY="1" />
        <Rectangle Canvas.Left="13.5"
                   Canvas.Top="1"
                   Width="3"
                   Height="11"
                   Fill="{Binding Foreground, ElementName=Root}"
                   RadiusX="1"
                   RadiusY="1" />

        <!--  Wi-Fi  -->
        <Path Data="M26 4a7 7 0 0 1 8 0l-1.2 1.4a5 5 0 0 0-5.6 0zM28 7a4 4 0 0 1 4 0l-1.1 1.4a2 2 0 0 0-1.8 0zM30 10.5l1-1.2-1-1.1-1 1.1z" Fill="{Binding Foreground, ElementName=Root}" />

        <!--  Battery  -->
        <Rectangle Canvas.Left="38"
                   Canvas.Top="1.5"
                   Width="12"
                   Height="9"
                   RadiusX="2.5"
                   RadiusY="2.5"
                   Stroke="{Binding Foreground, ElementName=Root}"
                   StrokeThickness="1" />
        <Rectangle Canvas.Left="39.5"
                   Canvas.Top="3"
                   Width="8"
                   Height="6"
                   Fill="{Binding Foreground, ElementName=Root}"
                   RadiusX="1.5"
                   RadiusY="1.5" />
        <Rectangle Canvas.Left="50.5"
                   Canvas.Top="4.5"
                   Width="1.5"
                   Height="3"
                   Fill="{Binding Foreground, ElementName=Root}"
                   RadiusX="0.7"
                   RadiusY="0.7" />
      </Canvas>
    </Viewbox>
  </Grid>
</UserControl>
