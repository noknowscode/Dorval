<UserControl x:Class="Dorval.Presentation.Controls.ScreenHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Dorval.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:utu="using:Uno.Toolkit.UI"
             x:Name="Root"
             mc:Ignorable="d">

  <!--  Detail screens share one header: back, what this is, and one optional action.  -->
  <StackPanel Padding="22,14,22,0"
              Background="{StaticResource CardBrush}"
              utu:SafeArea.Insets="Top">
    <controls:MockStatusBar Foreground="{StaticResource InkBrush}" />

    <Grid Height="40" Margin="0,12,0,0">
      <Button x:Name="BackButton"
              Margin="-8,0,0,0"
              HorizontalAlignment="Left"
              AutomationProperties.Name="Back"
              Style="{StaticResource CircleIconButtonStyle}"
              uen:Navigation.Request="-">
        <controls:IconGlyph Data="M19 12H5M11 6l-6 6 6 6"
                            IconStroke="{StaticResource InkBrush}"
                            Size="20" />
      </Button>

      <TextBlock x:Name="EyebrowText"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Style="{StaticResource EyebrowStyle}" />

      <ContentPresenter Margin="0,0,-8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="{Binding TrailingContent, ElementName=Root}" />
    </Grid>
  </StackPanel>
</UserControl>
