<UserControl x:Class="Dorval.Presentation.Controls.CityMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dorval.Presentation"
             x:Name="Root"
             mc:Ignorable="d">

  <!--
    A stylised Dorval, not a real map: the lakeshore along the bottom, four arteries,
    two green blocks. Drawn in a 343x150 design space so pin coordinates stay simple.
  -->
  <Border Height="150"
          Background="{StaticResource MapLandBrush}"
          BorderBrush="{StaticResource HairlineBrush}"
          BorderThickness="1"
          CornerRadius="18">
    <Grid>
      <Viewbox Stretch="Fill">
        <Canvas Width="343" Height="150">
          <Path Data="M0 110 C60 95 120 130 200 118 S300 120 343 100 V150 H0Z" Fill="{StaticResource MapWaterBrush}" />

          <!--  Roads: a wide white casing with a thin edge on the through-streets  -->
          <Path Data="M0 30 H343 M0 70 H343 M0 105 H343 M50 0 V110 M120 0 V120 M200 0 V118 M280 0 V115"
                Stroke="{StaticResource OnGreenBrush}"
                StrokeThickness="5" />
          <Path Data="M0 30 H343 M0 70 H343 M50 0 V110 M120 0 V120 M200 0 V118 M280 0 V115"
                Stroke="{StaticResource RuleBrush}"
                StrokeThickness="1" />

          <Rectangle Canvas.Left="60"
                     Canvas.Top="38"
                     Width="50"
                     Height="26"
                     Fill="{StaticResource MapParkBrush}"
                     RadiusX="4"
                     RadiusY="4" />
          <Rectangle Canvas.Left="215"
                     Canvas.Top="76"
                     Width="55"
                     Height="30"
                     Fill="{StaticResource MapParkBrush}"
                     RadiusX="4"
                     RadiusY="4" />
        </Canvas>
      </Viewbox>

      <!--  You are here  -->
      <Ellipse Width="30"
               Height="30"
               Margin="164,72,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Fill="{StaticResource LocateBrush}"
               Opacity="0.25" />
      <Ellipse Width="18"
               Height="18"
               Margin="170,78,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Fill="{StaticResource LocateBrush}"
               Stroke="{StaticResource OnGreenBrush}"
               StrokeThickness="3" />

      <ItemsControl ItemsSource="{Binding Pins, ElementName=Root}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MapPin">
            <Button Width="30"
                    Height="36"
                    Margin="{Binding Offset}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding Name}"
                    Command="{Binding Select}"
                    CommandParameter="{Binding Id}"
                    Style="{StaticResource PlainCardButtonStyle}">
              <Viewbox Width="30" Height="36">
                <Canvas Width="24" Height="30">
                  <Path Data="M12 29s10-9.5 10-17A10 10 0 0 0 2 12c0 7.5 10 17 10 17z"
                        Fill="{Binding Fill}"
                        Stroke="{StaticResource OnGreenBrush}"
                        StrokeThickness="1.5" />
                  <Ellipse Canvas.Left="8"
                           Canvas.Top="8"
                           Width="8"
                           Height="8"
                           Fill="{StaticResource OnGreenBrush}" />
                </Canvas>
              </Viewbox>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
