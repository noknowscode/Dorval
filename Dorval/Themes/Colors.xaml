<!--
  Dorval brand palette.
  Single-theme app: plain (non-theme) dictionary so custom keys resolve inside
  DataTemplates and custom dependency properties, which ThemeResource does not.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  Greens: the Dorval signature  -->
  <Color x:Key="GreenDeepColor">#1E4B32</Color>
  <Color x:Key="GreenMidColor">#2E6B44</Color>
  <Color x:Key="GreenSoftColor">#DDEBD3</Color>
  <Color x:Key="GreenPaleColor">#F1F6EC</Color>
  <Color x:Key="GreenLineColor">#B9CDB0</Color>
  <Color x:Key="GreenMutedColor">#9DBBA6</Color>
  <Color x:Key="GreenSprigColor">#7FA98A</Color>

  <!--  Heritage gold  -->
  <Color x:Key="GoldColor">#B8952F</Color>

  <!--  Ink  -->
  <Color x:Key="InkColor">#1C2A21</Color>
  <Color x:Key="InkMutedColor">#4C5850</Color>
  <Color x:Key="InkFaintColor">#6B7568</Color>

  <!--  Paper  -->
  <Color x:Key="PaperColor">#F5F3EC</Color>
  <Color x:Key="SurfaceColorX">#FFFFFF</Color>
  <Color x:Key="BorderColorX">#E4E1D6</Color>
  <Color x:Key="DividerColor">#EFEDE4</Color>
  <Color x:Key="RuleColor">#D9DCCB</Color>
  <Color x:Key="RowHoverColor">#FAF9F4</Color>

  <!--  Semantic accents  -->
  <Color x:Key="AmberColor">#F6E7C1</Color>
  <Color x:Key="AmberInkColor">#7A5A11</Color>
  <Color x:Key="AmberDeepColor">#3E2E05</Color>
  <Color x:Key="SkyColor">#D6E4EC</Color>
  <Color x:Key="SkyInkColor">#1F4B66</Color>
  <Color x:Key="LilacColor">#EFE3F2</Color>
  <Color x:Key="LilacInkColor">#5A2E66</Color>

  <!--  Map  -->
  <Color x:Key="MapLandColor">#E9ECDF</Color>
  <Color x:Key="MapWaterColor">#CFE0EC</Color>
  <Color x:Key="MapParkColor">#CFE0C4</Color>
  <Color x:Key="LocateColor">#3B7DD8</Color>

  <!--  Image-slot tints: what shows through before a photo loads  -->
  <Color x:Key="TintLeafColor">#C9D9C0</Color>
  <Color x:Key="TintWheatColor">#E3D9C2</Color>
  <Color x:Key="TintFernColor">#BFD3C6</Color>
  <Color x:Key="TintStoneColor">#D9DFD2</Color>
  <Color x:Key="TintMistColor">#E3E7DA</Color>

  <SolidColorBrush x:Key="GreenDeepBrush" Color="{StaticResource GreenDeepColor}" />
  <SolidColorBrush x:Key="GreenMidBrush" Color="{StaticResource GreenMidColor}" />
  <SolidColorBrush x:Key="GreenSoftBrush" Color="{StaticResource GreenSoftColor}" />
  <SolidColorBrush x:Key="GreenPaleBrush" Color="{StaticResource GreenPaleColor}" />
  <SolidColorBrush x:Key="GreenLineBrush" Color="{StaticResource GreenLineColor}" />
  <SolidColorBrush x:Key="GreenMutedBrush" Color="{StaticResource GreenMutedColor}" />
  <SolidColorBrush x:Key="GreenSprigBrush" Color="{StaticResource GreenSprigColor}" />
  <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />

  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMutedColor}" />
  <SolidColorBrush x:Key="InkFaintBrush" Color="{StaticResource InkFaintColor}" />

  <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource SurfaceColorX}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource BorderColorX}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="RuleBrush" Color="{StaticResource RuleColor}" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />

  <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="AmberInkBrush" Color="{StaticResource AmberInkColor}" />
  <SolidColorBrush x:Key="AmberDeepBrush" Color="{StaticResource AmberDeepColor}" />
  <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource SkyColor}" />
  <SolidColorBrush x:Key="SkyInkBrush" Color="{StaticResource SkyInkColor}" />
  <SolidColorBrush x:Key="LilacBrush" Color="{StaticResource LilacColor}" />
  <SolidColorBrush x:Key="LilacInkBrush" Color="{StaticResource LilacInkColor}" />

  <SolidColorBrush x:Key="MapLandBrush" Color="{StaticResource MapLandColor}" />
  <SolidColorBrush x:Key="MapWaterBrush" Color="{StaticResource MapWaterColor}" />
  <SolidColorBrush x:Key="MapParkBrush" Color="{StaticResource MapParkColor}" />
  <SolidColorBrush x:Key="LocateBrush" Color="{StaticResource LocateColor}" />

  <SolidColorBrush x:Key="TintLeafBrush" Color="{StaticResource TintLeafColor}" />
  <SolidColorBrush x:Key="TintWheatBrush" Color="{StaticResource TintWheatColor}" />
  <SolidColorBrush x:Key="TintFernBrush" Color="{StaticResource TintFernColor}" />
  <SolidColorBrush x:Key="TintStoneBrush" Color="{StaticResource TintStoneColor}" />
  <SolidColorBrush x:Key="TintMistBrush" Color="{StaticResource TintMistColor}" />

  <!--  Translucent whites used on the green header / tab bar  -->
  <SolidColorBrush x:Key="OnGreenBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="OnGreenSoftBrush" Color="#DDEBD3" />
  <SolidColorBrush x:Key="OnGreenWashBrush" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="OnGreenWashStrongBrush" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="OnGreenHairlineBrush" Color="#14FFFFFF" />

</ResourceDictionary>
